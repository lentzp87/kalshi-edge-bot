# Kalshi API credentials (https://kalshi.com/account/profile -> API Keys)
KALSHI_API_KEY_ID=your-api-key-id-here

# LOCAL: point to a PEM file
KALSHI_API_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# RENDER: paste the PEM contents directly. Render env vars are single-line,
# so escape newlines as literal \n. The loader un-escapes them.
# Example:
# KALSHI_API_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# paper | live   (always start in paper)
MODE=paper

# demo | prod    (demo points at https://demo-api.kalshi.co)
KALSHI_ENV=demo

# Where the SQLite journal lives. Render: /var/data (mounted disk).
DATA_DIR=./data

# Optional external data
OPEN_METEO_BASE=https://api.open-meteo.com/v1
NWS_USER_AGENT=kalshi-edge-bot (your-email@example.com)

# Dashboard. On Render, $PORT is auto-injected and overrides this.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
